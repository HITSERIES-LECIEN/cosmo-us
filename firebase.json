{
  "hosting": {
    "site": "cosmo-us",
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/blog",
        "destination": "/stories",
        "type": 301
      },
      {
        "source": "/blog/:slug",
        "destination": "/stories/:slug",
        "type": 301
      },
      {
        "source": "/faire",
        "destination": "/wholesale",
        "type": 301
      },
      {
        "source": "/floss/hidamari",
        "destination": "/sashiko",
        "type": 301
      },
      {
        "source": "/cloth",
        "destination": "/fabric",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
